DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
FIELD_ENCRYPTION_KEY=replace-with-fernet-key
DATABASE_NAME=avapharmacy
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
DEV_API_ANON_THROTTLE_RATE=10000/hour
DEV_API_USER_THROTTLE_RATE=10000/hour
API_PUBLIC_READ_THROTTLE_RATE=3000/hour
DJANGO_SETTINGS_MODULE=avapharmacy.settings.development
MEDIA_URL=/media/
STATIC_URL=/static/
REDIS_URL=redis://localhost:6379

# Frontend / App URLs
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:3000
ADMIN_EMAIL=info@avapharmacy.co.ke
PRESCRIPTION_UPLOAD_ALERT_EMAIL=info@avapharmacy.co.ke
FRONTEND_LOGIN_URL=http://localhost:3000/login
FRONTEND_PHARMACIST_DASHBOARD_URL=http://localhost:3000/pharmacist/dashboard
FRONTEND_PHARMACIST_ACTIVATION_PATH=/auth/pharmacist/activate

# Checkout / Payments
PAYMENT_WEBHOOK_SECRET=replace-with-random-shared-secret
FREE_SHIPPING_THRESHOLD=3000
SHIPPING_FEE=300

# Bot protection / Cloudflare Turnstile
# Production must use real keys and set BOT_CHALLENGE_REQUIRED=True.
BOT_CHALLENGE_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
BOT_CHALLENGE_REQUIRED=True
CHECKOUT_RISK_CHALLENGE_THRESHOLD=40
CHECKOUT_RISK_VERIFY_THRESHOLD=60
CHECKOUT_RISK_REVIEW_THRESHOLD=80
NEW_ACCOUNT_RISK_WINDOW_HOURS=24
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,tempmail.com,10minutemail.com,guerrillamail.com

# M-Pesa Daraja
# Use `sandbox` for Safaricom test credentials, `production` for live credentials.
MPESA_ENVIRONMENT=sandbox
# Daraja app credentials from Safaricom developer portal.
MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
# Business shortcode / paybill / till used for STK push.
MPESA_SHORTCODE=replace-with-shortcode
# Lipa Na M-Pesa Online passkey for the shortcode above.
MPESA_PASSKEY=replace-with-daraja-passkey
# Must be a public backend URL reachable by Safaricom, ending with this API path.
MPESA_CALLBACK_URL=https://your-backend.example.com/api/payments/mpesa/callback/
# Public HTTPS callback for consultation STK payments (gateway: /callbacks/consultation/stk/).
CONSULTATION_MPESA_CALLBACK_URL=
# Usually CustomerPayBillOnline for STK push.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TIMEOUT_SECONDS=30
# Optional temporary sandbox override. Leave blank in production.
MPESA_STK_PUSH_AMOUNT_OVERRIDE=1
MPESA_PAYBILL_NUMBER=replace-with-live-paybill
# Sandbox: use the C2B shortcode assigned in your Daraja app simulator, not the STK shortcode.
MPESA_C2B_SHORTCODE=replace-with-live-paybill
MPESA_C2B_API_VERSION=v2
MPESA_C2B_RESPONSE_TYPE=Completed
MPESA_C2B_URLS_REGISTERED=False
MPESA_REQUIRE_PUBLIC_CALLBACK_URLS=True
MPESA_STATUS_SYNC_MIN_INTERVAL_SECONDS=15
MPESA_STATUS_SYNC_RETRY_AFTER_429_SECONDS=65
MPESA_STATUS_SYNC_RETRY_AFTER_403_SECONDS=180
MPESA_C2B_VALIDATION_URL=https://your-backend.example.com/api/payments/mpesa/paybill/validation/
MPESA_C2B_CONFIRMATION_URL=https://your-backend.example.com/api/payments/mpesa/paybill/confirmation/
MPESA_PAYBILL_ACCOUNT_PREFIX=AVA-
MPESA_PAYBILL_ACCOUNT_LABEL=Account Number
MPESA_PAYBILL_INSTRUCTIONS=Pay using the M-Pesa Paybill details below. We confirm the payment automatically once Safaricom sends the callback.

# Flutterwave Card Payments
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_TIMEOUT_SECONDS=30
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/checkout

# POS / Order Push
POS_ORDER_PUSH_URL=
POS_ORDER_PUSH_TOKEN=
POS_ORDER_PUSH_TIMEOUT_SECONDS=15
POS_ORDER_PUSH_MAX_ATTEMPTS=3
POS_ORDER_PUSH_BACKOFF_SECONDS=1.0
POS_ORDER_PUSH_MAX_BACKOFF_SECONDS=8.0
POS_ORDER_PUSH_QUEUE_MAX_ATTEMPTS=10
POS_LINK_STRATEGY=sku_or_pos_id
POS_INVENTORY_LOOKUP_URL=
POS_INVENTORY_LOOKUP_TOKEN=
POS_INVENTORY_LOOKUP_TIMEOUT_SECONDS=8
POS_INVENTORY_LOOKUP_TTL_SECONDS=300

# Required: random shared callback token. The client adds it to STK and C2B
# callback URLs automatically; re-register existing C2B URLs after changing it.
# Keep callback URLs and access logs private; use HTTPS. Empty disables callbacks.
MPESA_CALLBACK_SECRET=

# Optional HTTPS payment-only gateway origin; never expose the complete dev server.
PAYMENT_PUBLIC_CALLBACK_BASE_URL=

# PPB working-day follow-up: approved Kenyan public holidays, comma-separated ISO dates.
# Keep empty until verified; production release checks require the current-year calendar.
KENYA_PUBLIC_HOLIDAYS=
# Superintendent must validate these clinical review thresholds.
MEDICINE_REVIEW_ORDERS_30D=3
MEDICINE_REVIEW_UNITS_30D=30

# Optional shared Redis cache for admin product/inventory reads. Blank uses the
# shared local file cache. Use a dedicated Redis database, separate from Celery.
ADMIN_CACHE_URL=
ADMIN_CATALOG_CACHE_TTL=60

# To use image CAPTCHA, match the frontend provider and configure real keys.
# BOT_CHALLENGE_PROVIDER=hcaptcha
# HCAPTCHA_SECRET_KEY=
# BOT_CHALLENGE_REQUIRED=True
