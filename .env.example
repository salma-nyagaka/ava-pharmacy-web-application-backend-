DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
FIELD_ENCRYPTION_KEY=replace-with-fernet-key
DATABASE_NAME=avapharmacy
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
DJANGO_SETTINGS_MODULE=avapharmacy.settings.development
MEDIA_URL=/media/
STATIC_URL=/static/
REDIS_URL=redis://localhost:6379

# Frontend / App URLs
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_LOGIN_URL=http://localhost:3000/login
FRONTEND_PHARMACIST_DASHBOARD_URL=http://localhost:3000/pharmacist/dashboard
FRONTEND_PHARMACIST_ACTIVATION_PATH=/auth/pharmacist/activate

# Checkout / Payments
PAYMENT_WEBHOOK_SECRET=replace-with-random-shared-secret
FREE_SHIPPING_THRESHOLD=3000
SHIPPING_FEE=300

# Bot protection / Cloudflare Turnstile
# Production must use real keys and set BOT_CHALLENGE_REQUIRED=True.
BOT_CHALLENGE_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
BOT_CHALLENGE_REQUIRED=True
CHECKOUT_RISK_CHALLENGE_THRESHOLD=40
CHECKOUT_RISK_VERIFY_THRESHOLD=60
CHECKOUT_RISK_REVIEW_THRESHOLD=80
NEW_ACCOUNT_RISK_WINDOW_HOURS=24
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,tempmail.com,10minutemail.com,guerrillamail.com

# M-Pesa Daraja
# Use `sandbox` for Safaricom test credentials, `production` for live credentials.
MPESA_ENVIRONMENT=sandbox
# Daraja app credentials from Safaricom developer portal.
MPESA_CONSUMER_KEY=j2QtF59JgUA6ETNJ0QsHGumBdJO3YnANI8cdZnQ5HANT1wpr
MPESA_CONSUMER_SECRET=LhOgUGZpaIYRtbQh4mpkfW6gOVHo3wxfGlfD8kxC1esG5ChyhgCgJFJJAMWIUijK
# Business shortcode / paybill / till used for STK push.
MPESA_SHORTCODE=174379
# Lipa Na M-Pesa Online passkey for the shortcode above.
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Must be a public backend URL reachable by Safaricom, ending with this API path.
MPESA_CALLBACK_URL=https://your-backend.example.com/api/payments/mpesa/callback/
# Usually CustomerPayBillOnline for STK push.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TIMEOUT_SECONDS=30
# Optional temporary sandbox override. Leave blank in production.
MPESA_STK_PUSH_AMOUNT_OVERRIDE=
MPESA_PAYBILL_NUMBER=replace-with-live-paybill
MPESA_C2B_SHORTCODE=replace-with-live-paybill
MPESA_C2B_RESPONSE_TYPE=Completed
MPESA_C2B_URLS_REGISTERED=False
MPESA_REQUIRE_PUBLIC_CALLBACK_URLS=True
MPESA_STATUS_SYNC_MIN_INTERVAL_SECONDS=15
MPESA_STATUS_SYNC_RETRY_AFTER_429_SECONDS=65
MPESA_STATUS_SYNC_RETRY_AFTER_403_SECONDS=180
MPESA_C2B_VALIDATION_URL=https://your-backend.example.com/api/payments/mpesa/paybill/validation/
MPESA_C2B_CONFIRMATION_URL=https://your-backend.example.com/api/payments/mpesa/paybill/confirmation/
MPESA_PAYBILL_ACCOUNT_PREFIX=AVA-
MPESA_PAYBILL_ACCOUNT_LABEL=Account Number
MPESA_PAYBILL_INSTRUCTIONS=Pay using the M-Pesa Paybill details below. We confirm the payment automatically once Safaricom sends the callback.

# Flutterwave Card Payments
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_TIMEOUT_SECONDS=30
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/checkout

